# Web3Forms access key — get one free at https://web3forms.com by entering the
# email address where you want quote requests delivered.
#
# This is a public key by design: it only permits posting to your own form,
# which is why it carries the NEXT_PUBLIC_ prefix. Set the same value in
# Vercel under Settings > Environment Variables.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
