# OPTIONAL. The canonical origin for canonical tags, the sitemap, and share
# links. Leave this unset on Vercel and the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which Vercel injects automatically — that is
# why the deployed site is already correct. Set it once a real domain is
# connected, so the .vercel.app address stops being advertised as canonical.
SITE_URL=

# OPTIONAL. FormSubmit works with no configuration at all — it delivers to the
# address in site.email. Everything below is a hardening step, not a
# requirement.
#
# After you activate the form (submit once, click the link FormSubmit emails
# you), FormSubmit issues a random alias for your address. Setting it here
# keeps the inbox address out of the JavaScript bundle where scrapers can read
# it. Set the same value in Vercel under Settings > Environment Variables, then
# redeploy — NEXT_PUBLIC_ values are baked in at build time.
NEXT_PUBLIC_FORMSUBMIT_ALIAS=
